@page "/venta"
@using Comercializadora.Core.Services.Abstractions
@using Comercializadora.Core.Models.BanQuito.Responses
@using Comercializadora.Core.Models.Comercializadora.Requests
@using Comercializadora.Core.Models.Comercializadora.Responses
@using Comercializadora.Core.Models.Comercializadora
@using Comercializadora.Shared.Shared
@inject ICreditoService CreditoService
@inject IFacturacionService FacturacionService
@inject IProductService ProductService

<PageTitle>Nueva Venta</PageTitle>

<div class="container-fluid py-3">
    <!-- Header Dinámico -->
    <div class="card mb-4 @(formaPagoSeleccionada == "EFECTIVO" ? "bg-success" : "bg-primary") text-white">
        <div class="card-body">
            <h1 class="card-title h3 mb-0">
                @if (formaPagoSeleccionada == "EFECTIVO")
                {
                    <span>💵 Nueva Venta en Efectivo</span>
                }
                else if (formaPagoSeleccionada == "CREDITO")
                {
                    <span>💳 Nueva Venta a Crédito</span>
                }
                else
                {
                    <span>🛒 Nueva Venta</span>
                }
            </h1>
        </div>
    </div>

    <!-- Wizard Steps -->
    <div class="card">
        <div class="card-body">

            <!-- ==================== PASO 0: SELECCIONAR FORMA DE PAGO ==================== -->
            @if (currentStep == 0)
            {
                <h4 class="mb-4">Paso 1: Seleccione la Forma de Pago</h4>
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="card h-100 border-success @GetBorderClass(EFECTIVO)" 
                             style="cursor: pointer;" @onclick="SeleccionarEfectivo">
                            <div class="card-body text-center py-5">
                                <div class="display-1 text-success mb-3">💵</div>
                                <h3 class="card-title">Pago en Efectivo</h3>
                                <p class="card-text text-muted">
                                    El cliente paga al momento de la compra.<br/>
                                    <strong class="text-success">¡33% de descuento aplicado!</strong>
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card h-100 border-primary @GetBorderClass(CREDITO)" 
                             style="cursor: pointer;" @onclick="SeleccionarCredito">
                            <div class="card-body text-center py-5">
                                <div class="display-1 text-primary mb-3">💳</div>
                                <h3 class="card-title">Pago a Crédito</h3>
                                <p class="card-text text-muted">
                                    Financiamiento a través de BanQuito.<br/>
                                    <strong class="text-primary">Cuotas de 3 a 24 meses.</strong>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
                
                @if (!string.IsNullOrEmpty(formaPagoSeleccionada))
                {
                    <div class="text-center mt-4">
                        <button class="btn btn-lg @(formaPagoSeleccionada == "EFECTIVO" ? "btn-success" : "btn-primary")" 
                                @onclick="ConfirmarFormaPago">
                            Continuar con @(formaPagoSeleccionada == "EFECTIVO" ? "Efectivo" : "Crédito") →
                        </button>
                    </div>
                }
            }

            <!-- ==================== PASO 1 (CRÉDITO): VALIDAR CLIENTE ==================== -->
            @if (currentStep == 1 && formaPagoSeleccionada == "CREDITO")
            {
                <div class="border-bottom pb-3 mb-3">
                    <small class="text-muted">Forma de Pago: <span class="badge bg-primary">💳 Crédito</span></small>
                </div>
                <h4 class="mb-3">Paso 2: Validar Cliente para Crédito</h4>
                <div class="input-group">
                    <input @bind="cedulaCliente" class="form-control" placeholder="Ingrese la cédula del cliente" @onkeyup="HandleCedulaKeyup" />
                    <button class="btn btn-primary" @onclick="ValidarCliente" disabled="@isBusy">
                        Validar
                    </button>
                </div>
            }

            <!-- ==================== PASO 1 (EFECTIVO): DATOS CLIENTE SIMPLES ==================== -->
            @if (currentStep == 1 && formaPagoSeleccionada == "EFECTIVO")
            {
                <div class="border-bottom pb-3 mb-3">
                    <small class="text-muted">Forma de Pago: <span class="badge bg-success">💵 Efectivo (33% Descuento)</span></small>
                </div>
                <h4 class="mb-3">Paso 2: Datos del Cliente</h4>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Cédula del Cliente</label>
                        <input @bind="cedulaCliente" class="form-control" placeholder="Ej: 1234567890" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Nombre del Cliente</label>
                        <input @bind="nombreCliente" class="form-control" placeholder="Ej: Juan Pérez" />
                    </div>
                </div>
                <div class="mt-3">
                    <button class="btn btn-success" @onclick="ContinuarEfectivo" 
                            disabled="@(string.IsNullOrWhiteSpace(cedulaCliente) || string.IsNullOrWhiteSpace(nombreCliente))">
                        Continuar al Carrito →
                    </button>
                </div>
            }

            <!-- ==================== PASO 2: CARRITO DE COMPRAS ==================== -->
            @if (currentStep >= 2)
            {
                <div class="border-bottom pb-3 mb-3">
                    @if (formaPagoSeleccionada == "CREDITO")
                    {
                        <h4 class="mb-1">Paso 2: Cliente Validado ✅</h4>
                        <p><strong>Cliente:</strong> @cedulaCliente</p>
                        <p class="mb-0"><strong>Monto Máximo de Crédito:</strong> @maxAmountResponse?.MontoMaximo.ToString("C")</p>
                    }
                    else
                    {
                        <h4 class="mb-1">Paso 2: Datos del Cliente ✅</h4>
                        <p><strong>Cliente:</strong> @nombreCliente (@cedulaCliente)</p>
                        <p class="mb-0 text-success"><strong>Descuento por Efectivo:</strong> 33%</p>
                    }
                </div>

                <h4 class="mb-3">Paso 3: Carrito de Compras</h4>

                <!-- Selector de Productos -->
                <div class="row g-3 align-items-end mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Seleccionar Producto</label>
                        <select class="form-select" @bind="selectedProductId">
                            <option value="0">-- Elija un producto --</option>
                            @if (allProducts != null)
                            {
                                @foreach (var product in allProducts)
                                {
                                    <option value="@product.ProductoId">@product.Nombre (@product.Precio.ToString("C"))</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Cantidad</label>
                        <input type="number" class="form-control" @bind="selectedProductQty" min="1" />
                    </div>
                    <div class="col-md-4">
                        <button class="btn btn-success w-100" @onclick="AgregarAlCarrito" disabled="@(selectedProductId == 0 || selectedProductQty <= 0)">
                            ➕ Agregar al Carrito
                        </button>
                    </div>
                </div>

                <!-- Carrito -->
                @if (carrito.Any())
                {
                    <ul class="list-group mb-3">
                        @foreach (var item in carrito)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                @item.Value.NombreProducto (@item.Value.Cantidad x @item.Value.PrecioUnitario.ToString("C"))
                                <div>
                                    <span class="fw-bold me-3">@item.Value.Subtotal.ToString("C")</span>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => EliminarDelCarrito(item.Key)">❌</button>
                                </div>
                            </li>
                        }
                    </ul>
                    <button class="btn btn-info" @onclick="CalcularTotal" disabled="@isBusy">
                        Calcular Total y Continuar →
                    </button>
                }
            }

            <!-- ==================== PASO 3 (CRÉDITO): CONFIRMAR Y OTORGAR CRÉDITO ==================== -->
            @if (currentStep >= 3 && formaPagoSeleccionada == "CREDITO")
            {
                <div class="border-bottom pb-3 mb-3 mt-4">
                    <h4 class="mb-1">Paso 3: Carrito Confirmado ✅</h4>
                    <p class="mb-0"><strong>Total de la Venta:</strong> @calculationResponse?.TotalCalculado.ToString("C")</p>
                    @if (isCreditApproved)
                    {
                        <div class="alert alert-success mt-2">✅ El monto de la venta es menor o igual al límite de crédito. Se puede proceder.</div>
                    }
                    else
                    {
                        <div class="alert alert-danger mt-2">❌ El monto de la venta excede el límite de crédito del cliente.</div>
                    }
                </div>

                <h4 class="mb-3">Paso 4: Otorgar Crédito y Facturar</h4>
                <div class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label">Número de Cuotas (3-24)</label>
                        <input type="number" class="form-control" @bind="numeroCuotas" min="3" max="24" />
                    </div>
                    <div class="col-md-8">
                        <button class="btn btn-danger w-100" @onclick="FinalizarVentaCredito" disabled="@(!isCreditApproved || isBusy || numeroCuotas < 3 || numeroCuotas > 24)">
                            FINALIZAR VENTA Y OTORGAR CRÉDITO
                        </button>
                    </div>
                </div>
            }

            <!-- ==================== PASO 3 (EFECTIVO): CONFIRMAR Y GENERAR FACTURA ==================== -->
            @if (currentStep >= 3 && formaPagoSeleccionada == "EFECTIVO")
            {
                <div class="border-bottom pb-3 mb-3 mt-4">
                    <h4 class="mb-1">Paso 3: Carrito Confirmado ✅</h4>
                    <div class="row">
                        <div class="col-md-6">
                            <p class="mb-1"><strong>Subtotal:</strong> @calculationResponse?.Subtotal.ToString("C")</p>
                            <p class="mb-1 text-success"><strong>Descuento (33%):</strong> -@calculationResponse?.Descuento.ToString("C")</p>
                            <p class="mb-0 fs-4"><strong>Total a Pagar:</strong> <span class="text-success">@calculationResponse?.TotalCalculado.ToString("C")</span></p>
                        </div>
                    </div>
                </div>

                <h4 class="mb-3">Paso 4: Confirmar Venta</h4>
                <div class="alert alert-success">
                    💵 El cliente pagará <strong>@calculationResponse?.TotalCalculado.ToString("C")</strong> en efectivo.
                </div>
                <button class="btn btn-success btn-lg w-100" @onclick="FinalizarVentaEfectivo" disabled="@isBusy">
                    GENERAR FACTURA EN EFECTIVO
                </button>
            }

            <!-- ==================== RESULTADO FINAL ==================== -->
            @if (currentStep == 4 && generatedInvoice != null)
            {
                <div class="mt-4 text-center">
                    <div class="display-1">🎉</div>
                    <h3>¡Venta Completada!</h3>
                    <p class="lead">La factura <strong>@generatedInvoice.NumeroFactura</strong> ha sido generada exitosamente.</p>
                    @if (formaPagoSeleccionada == "CREDITO" && !string.IsNullOrEmpty(generatedInvoice.NumeroCredito))
                    {
                        <p>Número de crédito asociado: <strong>@generatedInvoice.NumeroCredito</strong></p>
                    }
                    @if (formaPagoSeleccionada == "EFECTIVO")
                    {
                        <div class="alert alert-success">
                            💵 Pago en efectivo con <strong>33% de descuento</strong> aplicado.
                        </div>
                    }
                </div>

                <FacturaDetalleComponent Factura="generatedInvoice" />

                <!-- Tabla de Amortización (solo para crédito) -->
                @if (formaPagoSeleccionada == "CREDITO" && creditGrantResponse?.TablaAmortizacion != null && creditGrantResponse.TablaAmortizacion.Any())
                {
                    <h4 class="mt-5 mb-3">Tabla de Amortización del Crédito</h4>
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped">
                            <thead class="table-light">
                                <tr>
                                    <th># Cuota</th>
                                    <th class="text-end">Valor Cuota</th>
                                    <th class="text-end">Interés Pagado</th>
                                    <th class="text-end">Capital Pagado</th>
                                    <th class="text-end">Saldo</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in creditGrantResponse.TablaAmortizacion)
                                {
                                    <tr>
                                        <td>@item.NumeroCuota</td>
                                        <td class="text-end">@item.Cuota.ToString("C")</td>
                                        <td class="text-end">@item.Interes.ToString("C")</td>
                                        <td class="text-end">@item.Capital.ToString("C")</td>
                                        <td class="text-end">@item.SaldoPendiente.ToString("C")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <div class="text-center mt-4">
                    <button class="btn btn-secondary" @onclick="ResetPage">Realizar Nueva Venta</button>
                </div>
            }

            <!-- Mensajes de Estado y Error -->
            @if (isBusy)
            {
                <div class="d-flex align-items-center mt-3">
                    <div class="spinner-border spinner-border-sm" role="status"></div>
                    <span class="ms-2">Procesando...</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger mt-3">@errorMessage</div>
            }
        </div>
    </div>
</div>


@code {
    // Constantes para evitar problemas con comillas en Razor
    private const string EFECTIVO = "EFECTIVO";
    private const string CREDITO = "CREDITO";

    private int currentStep = 0; // Empieza en 0 para seleccionar forma de pago
    private bool isBusy = false;
    private string? errorMessage;

    // Paso 0: Forma de Pago
    private string formaPagoSeleccionada = "";

    // Paso 1 (Crédito) / Datos Cliente (Efectivo)
    private string cedulaCliente = "";
    private string nombreCliente = "";
    private CreditValidationResponse? validationResponse;
    private MaxCreditAmountResponse? maxAmountResponse;

    // Paso 2: Carrito
    private List<ProductDto>? allProducts;
    private int selectedProductId;
    private int selectedProductQty = 1;
    private Dictionary<int, InvoiceDetailDto> carrito = new();
    private CalculationResponse? calculationResponse;
    private bool isCreditApproved = false;

    // Paso 3 (Crédito)
    private int numeroCuotas = 12;

    // Paso 4: Resultado
    private InvoiceDto? generatedInvoice;
    private CreditGrantResponse? creditGrantResponse;

    protected override async Task OnInitializedAsync()
    {
        // Precargar la lista de productos para el selector
        allProducts = (await ProductService.ObtenerProductosAsync()).ToList();
    }

    private void SeleccionarFormaPago(string formaPago)
    {
        formaPagoSeleccionada = formaPago;
    }

    private void ConfirmarFormaPago()
    {
        if (!string.IsNullOrEmpty(formaPagoSeleccionada))
        {
            currentStep = 1;
        }
    }

    private void SeleccionarEfectivo() => formaPagoSeleccionada = EFECTIVO;
    private void SeleccionarCredito() => formaPagoSeleccionada = CREDITO;
    private string GetBorderClass(string formaPago) => formaPagoSeleccionada == formaPago ? "border-3" : "";

    private void ContinuarEfectivo()
    {
        if (!string.IsNullOrWhiteSpace(cedulaCliente) && !string.IsNullOrWhiteSpace(nombreCliente))
        {
            currentStep = 2;
        }
    }

    private async Task HandleCedulaKeyup(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ValidarCliente();
        }
    }

    private async Task ValidarCliente()
    {
        isBusy = true;
        errorMessage = null;

        try
        {
            validationResponse = await CreditoService.ValidarSujetoCreditoAsync(cedulaCliente);
            if (validationResponse.EsValido)
            {
                maxAmountResponse = await CreditoService.ObtenerMontoMaximoAsync(cedulaCliente);
                currentStep = 2;
            }
            else
            {
                errorMessage = validationResponse.Mensaje ?? "El cliente no es sujeto de crédito.";
            }
        }
        finally { isBusy = false; }
    }

    private void AgregarAlCarrito()
    {
        var product = allProducts?.FirstOrDefault(p => p.ProductoId == selectedProductId);
        if (product == null) return;

        if (carrito.ContainsKey(product.ProductoId))
        {
            carrito[product.ProductoId].Cantidad += selectedProductQty;
            carrito[product.ProductoId].Subtotal = carrito[product.ProductoId].Cantidad * carrito[product.ProductoId].PrecioUnitario;
        }
        else
        {
            carrito[product.ProductoId] = new InvoiceDetailDto
            {
                ProductoId = product.ProductoId,
                NombreProducto = product.Nombre,
                Cantidad = selectedProductQty,
                PrecioUnitario = product.Precio,
                Subtotal = selectedProductQty * product.Precio
            };
        }
        selectedProductId = 0;
        selectedProductQty = 1;
    }

    private void EliminarDelCarrito(int productId)
    {
        carrito.Remove(productId);
    }

    private async Task CalcularTotal()
    {
        isBusy = true;
        errorMessage = null;
        try
        {
            var request = new CalculationRequest
            {
                Items = carrito.Values.Select(v => new InvoiceRequestItemDto { ProductoId = v.ProductoId, Cantidad = v.Cantidad }).ToList()
            };
            calculationResponse = await FacturacionService.CalcularTotalFacturaAsync(request);

            if (calculationResponse != null)
            {
                if (formaPagoSeleccionada == "CREDITO")
                {
                    isCreditApproved = calculationResponse.TotalCalculado <= maxAmountResponse?.MontoMaximo;
                }
                currentStep = 3;
            }
            else
            {
                errorMessage = "Error al calcular el total: Respuesta nula.";
            }
        }
        finally { isBusy = false; }
    }

    private async Task FinalizarVentaCredito()
    {
        isBusy = true;
        errorMessage = null;
        creditGrantResponse = null;

        try
        {
            // 1. Otorgar el crédito en BanQuito
            var creditRequest = new Core.Models.BanQuito.Requests.CreditGrantRequest
            {
                Cedula = cedulaCliente,
                PrecioElectrodomestico = calculationResponse!.TotalCalculado,
                NumeroCuotas = numeroCuotas
            };

            creditGrantResponse = await CreditoService.OtorgarCreditoAsync(creditRequest);

            if (creditGrantResponse == null || !creditGrantResponse.Exito)
            {
                errorMessage = creditGrantResponse?.Mensaje ?? "El banco rechazó el otorgamiento del crédito.";
                isBusy = false;
                return;
            }

            // 2. Generar la factura
            var invoiceRequest = new InvoiceGenerationRequest
            {
                CedulaCliente = cedulaCliente,
                NombreCliente = "Cliente Mostrador",
                FormaPago = "CREDITO",
                NumeroCredito = creditGrantResponse.NumeroCredito,
                Items = carrito.Values.Select(v => new InvoiceRequestItemDto { ProductoId = v.ProductoId, Cantidad = v.Cantidad }).ToList()
            };

            generatedInvoice = await FacturacionService.GenerarFacturaAsync(invoiceRequest);

            if (generatedInvoice != null)
            {
                currentStep = 4;
            }
            else
            {
                errorMessage = "¡Atención! El crédito fue aprobado, pero hubo un error al generar la factura. Contacte a soporte.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error crítico: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task FinalizarVentaEfectivo()
    {
        isBusy = true;
        errorMessage = null;

        try
        {
            // Generar factura directamente con EFECTIVO (descuento del 33% aplicado por el backend)
            var invoiceRequest = new InvoiceGenerationRequest
            {
                CedulaCliente = cedulaCliente,
                NombreCliente = nombreCliente,
                FormaPago = "EFECTIVO",
                NumeroCredito = null,
                Items = carrito.Values.Select(v => new InvoiceRequestItemDto { ProductoId = v.ProductoId, Cantidad = v.Cantidad }).ToList()
            };

            generatedInvoice = await FacturacionService.GenerarFacturaAsync(invoiceRequest);

            if (generatedInvoice != null)
            {
                currentStep = 4;
            }
            else
            {
                errorMessage = "Error al generar la factura. Intente nuevamente.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private void ResetPage()
    {
        currentStep = 0;
        isBusy = false;
        errorMessage = null;
        formaPagoSeleccionada = "";
        cedulaCliente = "";
        nombreCliente = "";
        validationResponse = null;
        maxAmountResponse = null;
        carrito.Clear();
        calculationResponse = null;
        isCreditApproved = false;
        numeroCuotas = 12;
        generatedInvoice = null;
        creditGrantResponse = null;
    }
}