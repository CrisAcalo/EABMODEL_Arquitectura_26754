@page "/sucursales/{codigo:int}"
@inject ISucursalService SucursalService
@inject NavigationManager Navigation

<PageTitle>Detalles de Sucursal - EurekaBank</PageTitle>

<div class="container-responsive">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="/home" class="text-decoration-none">
                    <span class="me-1">??</span>Inicio
                </a>
            </li>
            <li class="breadcrumb-item">
                <a href="/sucursales" class="text-decoration-none">
                    <span class="me-1">??</span>Sucursales
                </a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                <span class="me-1">???</span>Detalles
            </li>
        </ol>
    </nav>

    <!-- Loading State -->
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-3 text-muted">Cargando información de la sucursal...</p>
        </div>
    }

    <!-- Error State -->
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">
                <div class="card card-responsive text-center">
                    <div class="card-body py-5">
                        <div class="mb-4">
                            <span style="font-size: 4rem;">?</span>
                        </div>
                        <h3 class="text-danger mb-3">Error al Cargar</h3>
                        <p class="text-muted mb-4">@errorMessage</p>
                        <div class="d-flex gap-2 justify-content-center">
                            <button class="btn btn-outline-primary btn-responsive" @onclick="CargarSucursal">
                                <span class="me-1">??</span>
                                Intentar de Nuevo
                            </button>
                            <button class="btn btn-secondary btn-responsive" @onclick="Regresar">
                                <span class="me-1">?</span>
                                Regresar
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Sucursal Details -->
    @if (!isLoading && sucursal != null)
    {
        <!-- Header -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h1 class="text-responsive-lg mb-2">
                            <span class="me-2">??</span>
                            @sucursal.Nombre
                        </h1>
                        <p class="text-muted mb-0">
                            <span class="me-1">??</span>
                            Código: <strong>@sucursal.Codigo</strong>
                        </p>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-warning btn-responsive" @onclick="EditarSucursal">
                            <span class="me-1">??</span>
                            <span class="d-none d-md-inline">Editar</span>
                        </button>
                        <button class="btn btn-outline-secondary btn-responsive" @onclick="Regresar">
                            <span class="me-1">?</span>
                            <span class="d-none d-md-inline">Regresar</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Information -->
        <div class="row g-4">
            <!-- Información Principal -->
            <div class="col-12 col-lg-8">
                <div class="card card-responsive h-100">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">
                            <span class="me-2">??</span>
                            Información Principal
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-4">
                            <!-- Información Básica -->
                            <div class="col-12">
                                <div class="info-section">
                                    <h6 class="text-primary mb-3">Datos Generales</h6>
                                    
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <div class="info-item">
                                                <label class="text-muted small">?? Nombre</label>
                                                <div class="fw-bold">@sucursal.Nombre</div>
                                            </div>
                                        </div>
                                        
                                        <div class="col-md-6">
                                            <div class="info-item">
                                                <label class="text-muted small">??? Ciudad</label>
                                                <div class="fw-bold">@sucursal.Ciudad</div>
                                            </div>
                                        </div>

                                        <div class="col-12">
                                            <div class="info-item">
                                                <label class="text-muted small">?? Dirección</label>
                                                <div class="fw-bold">@sucursal.Direccion</div>
                                            </div>
                                        </div>

                                        <div class="col-12">
                                            <div class="info-item">
                                                <label class="text-muted small">??? Dirección Completa</label>
                                                <div class="text-primary">@sucursal.DireccionCompleta</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Coordenadas -->
                            <div class="col-12">
                                <div class="info-section">
                                    <h6 class="text-primary mb-3">Ubicación GPS</h6>
                                    
                                    @if (sucursal.TieneCoordenadas)
                                    {
                                        <div class="row g-3">
                                            <div class="col-md-6">
                                                <div class="info-item">
                                                    <label class="text-muted small">?? Latitud</label>
                                                    <div class="fw-bold font-monospace">@sucursal.Latitud.ToString("F8")</div>
                                                </div>
                                            </div>
                                            
                                            <div class="col-md-6">
                                                <div class="info-item">
                                                    <label class="text-muted small">?? Longitud</label>
                                                    <div class="fw-bold font-monospace">@sucursal.Longitud.ToString("F8")</div>
                                                </div>
                                            </div>

                                            <div class="col-12">
                                                <div class="alert alert-success">
                                                    <span class="me-2">?</span>
                                                    <strong>Coordenadas GPS disponibles</strong>
                                                </div>
                                                
                                                <div class="d-flex gap-2 flex-wrap">
                                                    <button class="btn btn-outline-primary btn-sm" @onclick="AbrirEnGoogleMaps">
                                                        <span class="me-1">???</span>
                                                        Ver en Google Maps
                                                    </button>
                                                    <button class="btn btn-outline-info btn-sm" @onclick="CopiarCoordenadas">
                                                        <span class="me-1">??</span>
                                                        Copiar Coordenadas
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-warning">
                                            <span class="me-2">??</span>
                                            <strong>Sin coordenadas GPS</strong> - Esta sucursal no tiene ubicación GPS registrada.
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Estadísticas -->
            <div class="col-12 col-lg-4">
                <div class="card card-responsive h-100">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0">
                            <span class="me-2">??</span>
                            Estadísticas
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="stats-container">
                            <!-- Contador de Cuentas -->
                            <div class="stat-item text-center mb-4">
                                <div class="stat-icon mb-2">
                                    <span style="font-size: 2.5rem;">??</span>
                                </div>
                                <div class="stat-value display-4 fw-bold text-primary">
                                    @sucursal.ContadorCuentas
                                </div>
                                <div class="stat-label text-muted">
                                    Cuentas Registradas
                                </div>
                            </div>

                            <!-- Estado GPS -->
                            <div class="stat-item text-center mb-4">
                                <div class="stat-icon mb-2">
                                    @if (sucursal.TieneCoordenadas)
                                    {
                                        <span style="font-size: 2.5rem;" class="text-success">??</span>
                                    }
                                    else
                                    {
                                        <span style="font-size: 2.5rem;" class="text-muted">??</span>
                                    }
                                </div>
                                <div class="stat-value h4 fw-bold @(sucursal.TieneCoordenadas ? "text-success" : "text-muted")">
                                    @(sucursal.TieneCoordenadas ? "? Activo" : "? Sin GPS")
                                </div>
                                <div class="stat-label text-muted">
                                    Estado GPS
                                </div>
                            </div>

                            <!-- ID de Sucursal -->
                            <div class="stat-item text-center">
                                <div class="stat-icon mb-2">
                                    <span style="font-size: 2.5rem;">??</span>
                                </div>
                                <div class="stat-value h4 fw-bold text-secondary">
                                    #@sucursal.Codigo
                                </div>
                                <div class="stat-label text-muted">
                                    Código de Sucursal
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Acciones Adicionales -->
        <div class="row mt-4">
            <div class="col-12">
                <div class="card card-responsive">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">
                            <span class="me-2">?</span>
                            Acciones Rápidas
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex gap-2 flex-wrap">
                            <button class="btn btn-outline-warning btn-responsive" @onclick="EditarSucursal">
                                <span class="me-1">??</span>
                                Editar Información
                            </button>
                            
                            @if (sucursal.TieneCoordenadas)
                            {
                                <button class="btn btn-outline-primary btn-responsive" @onclick="AbrirEnGoogleMaps">
                                    <span class="me-1">???</span>
                                    Ver en Mapa
                                </button>
                            }
                            
                            <button class="btn btn-outline-info btn-responsive" @onclick="() => Navigation.NavigateTo(\"/sucursales\")">
                                <span class="me-1">??</span>
                                Ver Todas las Sucursales
                            </button>
                            
                            <button class="btn btn-outline-secondary btn-responsive" @onclick="() => Navigation.NavigateTo(\"/home\")">
                                <span class="me-1">??</span>
                                Ir al Inicio
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Codigo { get; set; }
    
    private SucursalDto? sucursal;
    private bool isLoading = true;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CargarSucursal();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (sucursal?.Codigo != Codigo)
        {
            await CargarSucursal();
        }
    }

    private async Task CargarSucursal()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;
            StateHasChanged();

            var response = await SucursalService.ObtenerSucursalAsync(Codigo);
            
            if (response.Exitoso && response.Datos != null)
            {
                sucursal = response.Datos;
            }
            else
            {
                errorMessage = response.Mensaje ?? "Sucursal no encontrada";
                sucursal = null;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error inesperado: {ex.Message}";
            sucursal = null;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void EditarSucursal()
    {
        Navigation.NavigateTo($"/sucursales/{Codigo}/editar");
    }

    private void Regresar()
    {
        Navigation.NavigateTo("/sucursales");
    }

    private void AbrirEnGoogleMaps()
    {
        if (sucursal?.TieneCoordenadas == true)
        {
            var url = $"https://www.google.com/maps?q={sucursal.Latitud},{sucursal.Longitud}";
            Navigation.NavigateTo(url, true);
        }
    }

    private async Task CopiarCoordenadas()
    {
        if (sucursal?.TieneCoordenadas == true)
        {
            var coordenadas = $"{sucursal.Latitud},{sucursal.Longitud}";
            // En un entorno real, aquí usarías JavaScript para copiar al portapapeles
            // await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", coordenadas);
        }
    }
}

<style>
    .info-section {
        border-bottom: 1px solid #e9ecef;
        padding-bottom: 1rem;
        margin-bottom: 1rem;
    }

    .info-section:last-child {
        border-bottom: none;
        margin-bottom: 0;
        padding-bottom: 0;
    }

    .info-item {
        margin-bottom: 0.75rem;
    }

    .info-item:last-child {
        margin-bottom: 0;
    }

    .info-item label {
        display: block;
        margin-bottom: 0.25rem;
        font-weight: 500;
    }

    .stats-container {
        text-align: center;
    }

    .stat-item {
        padding: 1rem;
        border-radius: 0.5rem;
        background: rgba(0,0,0,0.02);
        margin-bottom: 1rem;
    }

    .stat-item:last-child {
        margin-bottom: 0;
    }

    .stat-icon {
        opacity: 0.8;
    }

    .stat-value {
        margin: 0.5rem 0;
    }

    .stat-label {
        font-size: 0.9rem;
        font-weight: 500;
    }
</style>