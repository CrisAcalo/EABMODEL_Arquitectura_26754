@page "/sucursales/ruta"
@inject ISucursalService SucursalService
@inject NavigationManager Navigation

<PageTitle>Planificador de Rutas - EurekaBank</PageTitle>

<div class="container-responsive">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="/home" class="text-decoration-none">
                    <span class="me-1">🏠</span>Inicio
                </a>
            </li>
            <li class="breadcrumb-item">
                <a href="/sucursales" class="text-decoration-none">
                    <span class="me-1">🏢</span>Sucursales
                </a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">
                <span class="me-1">🗺️</span>Rutas
            </li>
        </ol>
    </nav>

    <div class="row mb-4">
        <div class="col-12">
            <h1 class="text-responsive-lg mb-2">
                <span class="me-2">🗺️</span>
                Planificador de Rutas
            </h1>
            <p class="text-muted">Calcula rutas y obtén indicaciones entre sucursales</p>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-3 text-muted">Cargando sucursales...</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Selector Panel -->
            <div class="col-12 col-lg-4">
                <div class="card card-responsive h-100">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">
                            <span class="me-2">📍</span>
                            Selección de Puntos
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-4">
                            <label class="form-label fw-bold">Origen</label>
                            <select class="form-select input-responsive" @bind="origenId">
                                <option value="0">-- Seleccione Origen --</option>
                                @foreach (var suc in sucursales)
                                {
                                    <option value="@suc.Codigo">@suc.Nombre (@suc.Ciudad)</option>
                                }
                            </select>
                            @if (origenId > 0 && GetSucursal(origenId) is var o && o?.TieneCoordenadas == false)
                            {
                                <div class="text-warning small mt-1">⚠️ Esta sucursal no tiene coordenadas GPS</div>
                            }
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Destino</label>
                            <select class="form-select input-responsive" @bind="destinoId">
                                <option value="0">-- Seleccione Destino --</option>
                                @foreach (var suc in sucursales)
                                {
                                    <option value="@suc.Codigo" disabled="@(suc.Codigo == origenId)">@suc.Nombre (@suc.Ciudad)</option>
                                }
                            </select>
                            @if (destinoId > 0 && GetSucursal(destinoId) is var d && d?.TieneCoordenadas == false)
                            {
                                <div class="text-warning small mt-1">⚠️ Esta sucursal no tiene coordenadas GPS</div>
                            }
                        </div>

                        <button class="btn btn-success w-100 btn-responsive" 
                                @onclick="CalcularRuta" 
                                disabled="@(!CanCalculate)">
                            <span class="me-2">🚗</span>
                            Calcular Ruta
                        </button>

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger mt-3">
                                @errorMessage
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Map View -->
            <div class="col-12 col-lg-8">
                <div class="card card-responsive h-100">
                     <div class="card-header bg-light">
                        <h5 class="mb-0">
                            <span class="me-2">🗺️</span>
                            Mapa de Ruta
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        @if (showMap && destinoActual != null)
                        {
                            <GoogleMapComponent @ref="mapComponent"
                                               Latitud="@destinoActual.Latitud"
                                               Longitud="@destinoActual.Longitud"
                                               Ancho="800"
                                               Alto="500"
                                               CssClass="h-100 w-100" />
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center h-100 bg-light p-5" style="min-height: 400px;">
                                <div class="text-center text-muted">
                                    <span style="font-size: 3rem;">🗺️</span>
                                    <p class="mt-2">Seleccione origen y destino para ver la ruta</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<SucursalDto> sucursales = new();
    private int origenId = 0;
    private int destinoId = 0;
    private bool isLoading = true;
    private string errorMessage = string.Empty;
    private bool showMap = false;
    
    // Logic state
    private SucursalDto? destinoActual;
    private GoogleMapComponent? mapComponent;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            var response = await SucursalService.ObtenerSucursalesAsync();
            if (response.Exitoso)
            {
                // Solo sucursales habilitadas, podriamos filtrar por las que tienen coordenadas
                sucursales = response.Datos ?? new List<SucursalDto>();
            }
            else
            {
                errorMessage = "No se pudieron cargar las sucursales: " + response.Mensaje;
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error cargando datos: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private SucursalDto? GetSucursal(int id) => sucursales.FirstOrDefault(s => s.Codigo == id);

    private bool CanCalculate => origenId > 0 && 
                                 destinoId > 0 && 
                                 origenId != destinoId && 
                                 GetSucursal(origenId)?.TieneCoordenadas == true && 
                                 GetSucursal(destinoId)?.TieneCoordenadas == true;

    private async Task CalcularRuta()
    {
        errorMessage = string.Empty;
        var origen = GetSucursal(origenId);
        var destino = GetSucursal(destinoId);

        if (origen == null || destino == null) return;

        // Force reload of map if destination changes
        // Strategy: Hide map, update destination, Show map (triggers init), then Calculate
        // Better Strategy: If we change destination, we might need a rerender if the component doesn't handle param update.
        // But for calculation, we just need to invoke the method.
        
        // HOWEVER, GoogleMapComponent is centered on Destination.
        // If we change destinationId, we want the map to re-center.
        
        bool destChanged = destinoActual?.Codigo != destino.Codigo;
        destinoActual = destino;
        showMap = true;
        
        if (destChanged)
        {
             // If dest changed, we need the component to re-init or re-render.
             // We can force a state change.
             showMap = false;
             StateHasChanged();
             await Task.Delay(1); 
             showMap = true;
             StateHasChanged();
             // Wait for render
             await Task.Delay(100); 
        }

        // Now calculate
        if (mapComponent != null)
        {
            await mapComponent.CalcularRuta(origen.Latitud, origen.Longitud);
        }
    }
}
