@page "/reportes"
@using CLIEurekabank.Shared.Services
@using CLIEurekabank.Shared.Services.Wrappers
@using CLIEurekabank.Shared.Components.Icons
@inject ReporteService ReporteService
@inject BloqueoService BloqueoService
@inject AppState AppState
@implements IAsyncDisposable

<PageTitle>EurekaBank - Reportes</PageTitle>

<h4 class="mb-4" style="color: var(--eb-navy);">
    <SvgIcon Path="@IconPaths.ChartBar" Size="24" Class="me-2" />
    Historial de Movimientos
</h4>

<div class="card-eb mb-4">
    <div class="card-eb-header d-flex justify-content-between align-items-center">
        <span>Consultar Movimientos</span>
        @if (IsCuentaBloqueada)
        {
            <span class="badge bg-danger">
                <i class="bi bi-lock-fill me-1"></i> CUENTA BLOQUEADA
            </span>
        }
    </div>
    <div class="p-3" style="@(IsCuentaBloqueada ? "border: 2px solid red; opacity: 0.8;" : "")">
        
        @if (IsCuentaBloqueada)
        {
            <div class="alert alert-warning mb-3">
                <strong>Atención:</strong> La cuenta @codigoCuenta está siendo utilizada por la ventanilla @VentanillaBloqueadora.
            </div>
        }

        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label small text-muted">Código de Cuenta</label>
                <input type="text" class="form-control" @bind="codigoCuenta" @bind:event="oninput" 
                       placeholder="Ej: 001-001-0001" />
            </div>
            <div class="col-md-2">
                <button class="btn btn-eb-primary w-100" @onclick="ConsultarMovimientos" disabled="@(isLoading || IsCuentaBloqueada)">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <SvgIcon Path="@IconPaths.Search" Size="18" Class="me-1" />
                        <span>Consultar</span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@if (movimientos.Any())
{
    <div class="card-eb">
        <div class="card-eb-header d-flex justify-content-between">
            <span>Movimientos de Cuenta: @codigoCuenta</span>
            <span class="badge bg-secondary">@movimientos.Count registros</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>N°</th>
                        <th>Fecha</th>
                        <th>Tipo</th>
                        <th class="text-end">Monto</th>
                        <th>Referencia</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var mov in movimientos)
                    {
                        <tr>
                            <td><span class="badge bg-secondary">@mov.NumeroMovimiento</span></td>
                            <td>@mov.Fecha</td>
                            <td>
                                <span class="badge @(mov.EsIngreso ? "bg-success" : "bg-danger")">
                                    @mov.TipoDisplay
                                </span>
                            </td>
                            <td class="text-end fw-bold @(mov.EsIngreso ? "text-success" : "text-danger")">
                                @(mov.EsIngreso ? "+" : "-") S/ @mov.Monto.ToString("N2")
                            </td>
                            <td class="text-muted small">@mov.Referencia</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else if (!string.IsNullOrEmpty(codigoCuenta) && !isLoading && !IsCuentaBloqueada)
{
    <div class="text-center py-5 text-muted">
        <SvgIcon Path="@IconPaths.ChartBar" Size="48" />
        <p class="mt-2">No hay movimientos para esta cuenta</p>
    </div>
}

@code {
    private string codigoCuenta = "";
    private List<MovimientoDTO> movimientos = new();
    private bool isLoading = false;

    // Estado de bloqueo
    private string VentanillaBloqueadora = "";
    private bool IsCuentaBloqueada => !string.IsNullOrEmpty(VentanillaBloqueadora) && VentanillaBloqueadora != CodigoVentanilla;
    private string CodigoVentanilla => AppState.EmpleadoActual?.CodigoVentanilla ?? "V01";

    protected override async Task OnInitializedAsync()
    {
        BloqueoService.OnEstadoCuentaChanged += HandleEstadoChanged;
        await BloqueoService.ConnectAsync();
    }

    private void HandleEstadoChanged(EstadoCuentaMensaje estado)
    {
        if (estado.Cuenta == codigoCuenta)
        {
            if (estado.Estado == "BLOQUEADO")
            {
                VentanillaBloqueadora = estado.Ventanilla;
            }
            else
            {
                VentanillaBloqueadora = "";
            }
            InvokeAsync(StateHasChanged);
        }
    }

    private async Task ConsultarMovimientos()
    {
        if (string.IsNullOrWhiteSpace(codigoCuenta)) return;

        if (IsCuentaBloqueada) return;

        isLoading = true;
        movimientos.Clear();
        StateHasChanged();

        // Bloquear temporalmente durante la consulta
        await BloqueoService.BloquearCuentaAsync(codigoCuenta, CodigoVentanilla);
        await Task.Delay(200); // UI visual effect

        try 
        {
            movimientos = await ReporteService.ObtenerMovimientosAsync(codigoCuenta.Trim());
        }
        finally
        {
            await BloqueoService.LiberarCuentaAsync(codigoCuenta, CodigoVentanilla);
        }

        isLoading = false;
    }

    public async ValueTask DisposeAsync()
    {
        BloqueoService.OnEstadoCuentaChanged -= HandleEstadoChanged;
        if (!string.IsNullOrEmpty(codigoCuenta) && isLoading)
        {
             await BloqueoService.LiberarCuentaAsync(codigoCuenta, CodigoVentanilla);
        }
    }
}
