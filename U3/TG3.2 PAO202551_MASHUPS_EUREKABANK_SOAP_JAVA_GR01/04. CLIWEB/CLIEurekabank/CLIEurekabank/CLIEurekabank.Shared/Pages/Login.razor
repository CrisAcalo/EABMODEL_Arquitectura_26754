@page "/login"
@layout EmptyLayout
@using CLIEurekabank.Shared.Services
@using CLIEurekabank.Shared.Services.Wrappers
@using CLIEurekabank.Shared.Components.Icons
@inject AuthService AuthService
@inject VentanillaService VentanillaService
@inject AppState AppState
@inject NavigationManager NavManager

<div class="login-container">
    <div class="login-card">
        <div class="login-logo">
            <SvgIcon Path="@IconPaths.CreditCard" Size="32" />
        </div>
        
        <h4 class="text-center fw-bold mb-1" style="color: var(--eb-navy);">EurekaBank</h4>
        <p class="text-center text-muted mb-4">Ingrese sus credenciales</p>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger d-flex align-items-center gap-2 py-2">
                <SvgIcon Path="@IconPaths.ExclamationCircle" Size="20" />
                <span>@errorMessage</span>
            </div>
        }

        <div class="mb-3">
            <label class="form-label small text-muted">Usuario</label>
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0">
                    <SvgIcon Path="@IconPaths.Users" Size="18" Class="text-muted" />
                </span>
                <input type="text" class="form-control border-start-0" 
                       placeholder="Ingrese usuario" @bind="usuario" @bind:event="oninput" />
            </div>
        </div>

        <div class="mb-4">
            <label class="form-label small text-muted">Contraseña</label>
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0">
                    <SvgIcon Path="@IconPaths.LockClosed" Size="18" Class="text-muted" />
                </span>
                <input type="password" class="form-control border-start-0" 
                       placeholder="Ingrese contraseña" @bind="clave" @bind:event="oninput" 
                       @onkeypress="HandleKeyPress" />
            </div>
        </div>

        <button class="btn btn-eb-primary w-100 py-2" @onclick="HandleLogin" disabled="@isLoading">
            @if (isLoading)
            {
                <span class="spinner-border spinner-border-sm me-2"></span>
                <span>Ingresando...</span>
            }
            else
            {
                <SvgIcon Path="@IconPaths.Login" Size="18" Class="me-2" />
                <span>Iniciar Sesión</span>
            }
        </button>
    </div>
</div>

@code {
    private string usuario = "";
    private string clave = "";
    private string errorMessage = "";
    private bool isLoading = false;

    protected override void OnInitialized()
    {
        // Si ya está autenticado, redirigir al dashboard
        if (AppState.IsAuthenticated)
        {
            NavManager.NavigateTo("/");
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await HandleLogin();
        }
    }

    private async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(usuario) || string.IsNullOrWhiteSpace(clave))
        {
            errorMessage = "Complete todos los campos";
            return;
        }

        isLoading = true;
        errorMessage = "";
        StateHasChanged();

        var (success, message, empleado) = await AuthService.LoginAsync(usuario, clave);
        
        if (success && empleado != null)
        {
            try 
            {
                // Buscar ventanilla asignada si no vino en el objeto (que sabemos que no viene)
                var ventanillas = await VentanillaService.ListarVentanillasActivasAsync();
                var miVentanilla = ventanillas.FirstOrDefault(v => v.CodigoEmpleado == empleado.Codigo);
                
                if (miVentanilla != null)
                {
                    empleado.CodigoVentanilla = miVentanilla.Codigo;
                }
                else
                {
                    // Fallback si no tiene ventanilla asignada
                     Console.WriteLine("ADVERTENCIA: Empleado sin ventanilla asignada.");
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error recuperando ventanilla: {ex.Message}");
            }

            // Guardar el empleado completo en el estado
            AppState.SetEmpleado(empleado);
            NavManager.NavigateTo("/");
        }
        else
        {
            errorMessage = message;
        }

        isLoading = false;
    }
}
