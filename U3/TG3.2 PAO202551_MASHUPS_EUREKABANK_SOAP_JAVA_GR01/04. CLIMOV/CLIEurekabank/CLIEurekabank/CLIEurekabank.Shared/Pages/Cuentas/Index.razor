@page "/cuentas"
@using CLIEurekabank.Shared.Services.Wrappers
@using CLIEurekabank.Shared.Components.Icons
@inject CuentaService CuentaService
@inject MonedaService MonedaService
@inject SucursalService SucursalService

<PageTitle>EurekaBank - Cuentas</PageTitle>

<h4 class="mb-4" style="color: var(--eb-navy);">
    <SvgIcon Path="@IconPaths.CreditCard" Size="24" Class="me-2" />
    Gestión de Cuentas
</h4>

<!-- Búsqueda y Acciones -->
<div class="card-eb mb-4">
    <div class="card-eb-header d-flex justify-content-between align-items-center">
        <span>Cuentas</span>
        <button class="btn btn-sm btn-eb-primary" @onclick="MostrarFormularioNuevo">
            <SvgIcon Path="@IconPaths.Plus" Size="16" Class="me-1" />
            Nueva Cuenta
        </button>
    </div>
    <div class="p-3">
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label small text-muted">Código de Cuenta</label>
                <input type="text" class="form-control" @bind="codigoBusqueda" @bind:event="oninput" placeholder="Ej: 001-001-0001" />
            </div>
            <div class="col-md-2">
                <button class="btn btn-eb-primary w-100" @onclick="BuscarCuenta" disabled="@isLoading">
                    <SvgIcon Path="@IconPaths.Search" Size="18" Class="me-1" />
                    Buscar
                </button>
            </div>
            <div class="col-md-2">
                <button class="btn btn-outline-secondary w-100" @onclick="CargarCuentas" disabled="@isLoading">
                    <SvgIcon Path="@IconPaths.Refresh" Size="18" Class="me-1" />
                    Todas
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Mensaje de Operación -->
@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert @(operacionExitosa ? "alert-success" : "alert-danger") alert-dismissible py-2 mb-4">
        @mensaje
        <button type="button" class="btn-close btn-sm" @onclick="() => mensaje = string.Empty"></button>
    </div>
}

<!-- Formulario Nueva/Editar Cuenta -->
@if (mostrarFormulario)
{
    <div class="card-eb mb-4 border-primary">
        <div class="card-eb-header bg-primary text-white d-flex justify-content-between">
            <span>@(esEdicion ? "Editar Cuenta" : "Abrir Nueva Cuenta")</span>
            <button class="btn btn-sm btn-close btn-close-white" @onclick="CerrarFormulario"></button>
        </div>
        <div class="p-4">
            <div class="row g-3">
                @if (esEdicion)
                {
                    <div class="col-md-4">
                        <label class="form-label">Código</label>
                        <input type="text" class="form-control" value="@cuentaForm.Codigo" disabled />
                    </div>
                }
                <div class="col-md-4">
                    <label class="form-label">Código Cliente <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" @bind="cuentaForm.CodigoCliente" placeholder="Ej: C001" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Moneda <span class="text-danger">*</span></label>
                    <select class="form-select" @bind="cuentaForm.CodigoMoneda">
                        <option value="">Seleccione...</option>
                        @foreach (var moneda in listaMonedas)
                        {
                            <option value="@moneda.Codigo">@moneda.Descripcion (@moneda.Codigo)</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Sucursal <span class="text-danger">*</span></label>
                    <select class="form-select" @bind="cuentaForm.CodigoSucursal">
                        <option value="">Seleccione...</option>
                        @foreach (var sucursal in listaSucursales)
                        {
                            <option value="@sucursal.Codigo">@sucursal.Nombre (@sucursal.Codigo)</option>
                        }
                    </select>
                </div>
                @if (esEdicion)
                {
                    <div class="col-md-4">
                        <label class="form-label">Estado</label>
                        <select class="form-select" @bind="cuentaForm.Estado">
                            <option value="A">Activa</option>
                            <option value="C">Cancelada</option>
                        </select>
                    </div>
                }
                <div class="col-md-4">
                    <label class="form-label">@(esEdicion ? "Nueva Clave (dejar vacío para no cambiar)" : "Clave de Cuenta *")</label>
                    <input type="password" class="form-control" @bind="formClave" />
                </div>
                @if (!esEdicion)
                {
                    <div class="col-md-4">
                        <label class="form-label">Saldo Inicial</label>
                        <div class="input-group">
                            <span class="input-group-text">S/</span>
                            <input type="number" class="form-control" @bind="formSaldoInicial" step="0.01" min="0" />
                        </div>
                    </div>
                }
            </div>
            <div class="mt-4 d-flex gap-2">
                <button class="btn btn-eb-primary" @onclick="GuardarCuenta" disabled="@isLoading">
                    @if (isLoading) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    <SvgIcon Path="@IconPaths.CheckCircle" Size="18" Class="me-1" />
                    @(esEdicion ? "Actualizar" : "Abrir Cuenta")
                </button>
                <button class="btn btn-outline-secondary" @onclick="CerrarFormulario">Cancelar</button>
            </div>
        </div>
    </div>
}

<!-- Tabla de Cuentas -->
@if (isLoading && !mostrarFormulario)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary"></div>
        <p class="text-muted mt-2">Cargando...</p>
    </div>
}
else if (cuentas.Any())
{
    <div class="card-eb">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Código</th>
                        <th>Cliente</th>
                        <th>Sucursal</th>
                        <th>Moneda</th>
                        <th class="text-end">Saldo</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center" style="width: 150px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cuenta in cuentas)
                    {
                        <tr>
                            <td><span class="badge bg-secondary">@cuenta.Codigo</span></td>
                            <td>@cuenta.CodigoCliente</td>
                            <td>@GetNombreSucursal(cuenta.CodigoSucursal)</td>
                            <td>@GetDescripcionMoneda(cuenta.CodigoMoneda)</td>
                            <td class="text-end fw-bold" style="color: var(--eb-primary);">
                                @GetSimboloMoneda(cuenta.CodigoMoneda) @cuenta.Saldo.ToString("N2")
                            </td>
                            <td class="text-center">
                                <span class="badge @(cuenta.Estado == "A" ? "bg-success" : "bg-danger")">
                                    @(cuenta.Estado == "A" ? "Activa" : "Cancelada")
                                </span>
                            </td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditarCuenta(cuenta)" title="Editar">
                                    <SvgIcon Path="@IconPaths.DocumentText" Size="16" />
                                </button>
                                @if (cuenta.Estado == "A")
                                {
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmarCancelar(cuenta)" title="Cancelar">
                                        <SvgIcon Path="@IconPaths.XCircle" Size="16" />
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-success" @onclick="() => ActivarCuenta(cuenta)" title="Activar">
                                        <SvgIcon Path="@IconPaths.CheckCircle" Size="16" />
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else if (!string.IsNullOrEmpty(codigoBusqueda))
{
    <div class="text-center py-5 text-muted">
        <SvgIcon Path="@IconPaths.CreditCard" Size="48" />
        <p class="mt-2">Cuenta no encontrada</p>
    </div>
}

<!-- Modal Confirmación Cancelar -->
@if (cuentaACancelar != null)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Confirmar Cancelación</h5>
                </div>
                <div class="modal-body">
                    <p>¿Está seguro de cancelar la cuenta <strong>@cuentaACancelar.Codigo</strong>?</p>
                    <p class="text-muted small mb-0">Saldo actual: S/ @cuentaACancelar.Saldo.ToString("N2")</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => cuentaACancelar = null">No, Volver</button>
                    <button class="btn btn-danger" @onclick="CancelarCuenta" disabled="@isLoading">
                        @if (isLoading) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Sí, Cancelar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<CuentaDTO> cuentas = new();
    private CuentaDTO cuentaForm = new();
    private CuentaDTO? cuentaACancelar;
    private string codigoBusqueda = "";
    private string mensaje = "";
    private bool operacionExitosa = false;
    private bool isLoading = false;
    private bool mostrarFormulario = false;
    private bool esEdicion = false;

    // Listas para selects
    private List<MonedaDTO> listaMonedas = new();
    private List<SucursalDTO> listaSucursales = new();

    // Formulario
    private string formClave = "";
    private decimal formSaldoInicial = 0;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatosMaestros();
        await CargarCuentas();
    }

    private async Task CargarDatosMaestros()
    {
        listaMonedas = await MonedaService.ListarMonedasAsync();
        listaSucursales = await SucursalService.ListarSucursalesAsync();
    }

    private async Task CargarCuentas()
    {
        isLoading = true;
        StateHasChanged();
        cuentas = await CuentaService.ListarCuentasActivasAsync();
        isLoading = false;
    }

    private async Task BuscarCuenta()
    {
        if (string.IsNullOrWhiteSpace(codigoBusqueda)) return;

        isLoading = true;
        StateHasChanged();

        var cuenta = await CuentaService.ObtenerCuentaAsync(codigoBusqueda.Trim());
        cuentas = cuenta != null ? new List<CuentaDTO> { cuenta } : new List<CuentaDTO>();

        if (cuenta == null)
        {
            mensaje = "Cuenta no encontrada";
            operacionExitosa = false;
        }

        isLoading = false;
    }

    private void MostrarFormularioNuevo()
    {
        cuentaForm = new CuentaDTO();
        formClave = "";
        formSaldoInicial = 0;
        esEdicion = false;
        mostrarFormulario = true;
    }

    private void EditarCuenta(CuentaDTO cuenta)
    {
        cuentaForm = new CuentaDTO
        {
            Codigo = cuenta.Codigo,
            CodigoCliente = cuenta.CodigoCliente,
            CodigoMoneda = cuenta.CodigoMoneda,
            CodigoSucursal = cuenta.CodigoSucursal,
            Estado = cuenta.Estado,
            Saldo = cuenta.Saldo
        };
        formClave = "";
        esEdicion = true;
        mostrarFormulario = true;
    }

    private void CerrarFormulario()
    {
        mostrarFormulario = false;
        cuentaForm = new CuentaDTO();
    }

    private async Task GuardarCuenta()
    {
        if (string.IsNullOrWhiteSpace(cuentaForm.CodigoCliente) || 
            string.IsNullOrWhiteSpace(cuentaForm.CodigoMoneda) || 
            string.IsNullOrWhiteSpace(cuentaForm.CodigoSucursal))
        {
            mensaje = "Complete todos los campos obligatorios";
            operacionExitosa = false;
            return;
        }

        if (!esEdicion && string.IsNullOrWhiteSpace(formClave))
        {
            mensaje = "Ingrese la clave de cuenta";
            operacionExitosa = false;
            return;
        }

        isLoading = true;
        StateHasChanged();

        OperacionResultado resultado;
        if (esEdicion)
        {
            resultado = await CuentaService.ActualizarCuentaAsync(cuentaForm, string.IsNullOrEmpty(formClave) ? null : formClave);
        }
        else
        {
            resultado = await CuentaService.AbrirCuentaAsync(
                cuentaForm.CodigoCliente, cuentaForm.CodigoMoneda, cuentaForm.CodigoSucursal, formClave, formSaldoInicial);
        }

        mensaje = resultado.Message;
        operacionExitosa = resultado.Success;

        if (resultado.Success)
        {
            CerrarFormulario();
            await CargarCuentas();
        }

        isLoading = false;
    }

    private void ConfirmarCancelar(CuentaDTO cuenta)
    {
        cuentaACancelar = cuenta;
    }

    private async Task CancelarCuenta()
    {
        if (cuentaACancelar == null) return;

        isLoading = true;
        StateHasChanged();

        var resultado = await CuentaService.CancelarCuentaAsync(cuentaACancelar.Codigo);
        mensaje = resultado.Message;
        operacionExitosa = resultado.Success;

        cuentaACancelar = null;

        if (resultado.Success)
        {
            await CargarCuentas();
        }

        isLoading = false;
    }

    private async Task ActivarCuenta(CuentaDTO cuenta)
    {
        isLoading = true;
        StateHasChanged();

        var resultado = await CuentaService.ActivarCuentaAsync(cuenta.Codigo);
        mensaje = resultado.Message;
        operacionExitosa = resultado.Success;

        if (resultado.Success)
        {
            await CargarCuentas();
        }

        isLoading = false;
    }

    // Helpers para mostrar nombres en lugar de códigos
    private string GetNombreSucursal(string codigo)
    {
        return listaSucursales.FirstOrDefault(s => s.Codigo == codigo)?.Nombre ?? codigo;
    }

    private string GetDescripcionMoneda(string codigo)
    {
        return listaMonedas.FirstOrDefault(m => m.Codigo == codigo)?.Descripcion ?? codigo;
    }

    private string GetSimboloMoneda(string codigo)
    {
        return codigo == "01" ? "S/ " : (codigo == "02" ? "$ " : "€ ");
    }
}
